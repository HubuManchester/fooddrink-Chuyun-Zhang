<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FoodDrinkApp.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <x:Double x:Key="BaseFontSize">14</x:Double>
            <x:Double x:Key="TitleFontSize">22</x:Double>
            <x:Double x:Key="SubtitleFontSize">16</x:Double>
            <Color x:Key="PageBackgroundColor">#FFFFFF</Color>
            <Color x:Key="PrimaryTextColor">#1A1A1A</Color>
            <Color x:Key="SecondaryTextColor">#555555</Color>
            <Color x:Key="CardBackgroundColor">#F7F7F7</Color>
            <Color x:Key="AccentColor">#2E7D32</Color>
            <Color x:Key="PrimaryButtonColor">#2E7D32</Color>
            <Color x:Key="PrimaryButtonTextColor">#FFFFFF</Color>
        </ResourceDictionary>
    </Application.Resources>
</Application>
