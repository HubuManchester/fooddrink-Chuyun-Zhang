<?xml version="1.0" encoding="utf-8" ?>
<helpers:ThemedContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helpers="clr-namespace:FoodDrinkApp.Helpers"
             xmlns:vm="clr-namespace:FoodDrinkApp.ViewModels"
             x:Class="FoodDrinkApp.Views.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Title="{Binding Title}"
             BackgroundColor="{DynamicResource PageBackgroundColor}">

    <ScrollView Padding="16">
        <VerticalStackLayout Spacing="16">
            <Label Text="Accessibility options"
                   FontSize="{DynamicResource TitleFontSize}"
                   TextColor="{DynamicResource PrimaryTextColor}"
                   SemanticProperties.HeadingLevel="Level1" />
            <Label Text="Light and dark mode follow your device system setting automatically. Adjust text size and contrast below."
                   TextColor="{DynamicResource SecondaryTextColor}" />

            <Border Padding="16" BackgroundColor="{DynamicResource CardBackgroundColor}"
                    Stroke="{DynamicResource AccentColor}" StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Large text" VerticalOptions="Center" TextColor="{DynamicResource PrimaryTextColor}" />
                        <Switch Grid.Column="1" IsToggled="{Binding UseLargeFont}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="High contrast" VerticalOptions="Center" TextColor="{DynamicResource PrimaryTextColor}" />
                        <Switch Grid.Column="1" IsToggled="{Binding UseHighContrast}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Button Text="Reset accessibility settings" Command="{Binding ResetAccessibilityCommand}" />
            <Label Text="{Binding StatusMessage}" TextColor="{DynamicResource SecondaryTextColor}" />
        </VerticalStackLayout>
    </ScrollView>
</helpers:ThemedContentPage>
