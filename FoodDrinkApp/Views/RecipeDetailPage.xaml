<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FoodDrinkApp.ViewModels"
             xmlns:converters="clr-namespace:FoodDrinkApp.Converters"
             x:Class="FoodDrinkApp.Views.RecipeDetailPage"
             x:DataType="vm:RecipeDetailViewModel"
             Title="{Binding Title}"
             BackgroundColor="{DynamicResource PageBackgroundColor}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:FavoriteGlyphConverter x:Key="FavoriteGlyphConverter" />
            <converters:StringNotEmptyConverter x:Key="StringNotEmptyConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView Padding="16">
        <VerticalStackLayout Spacing="16">
            <Image Source="{Binding Recipe.ImagePath}"
                   HeightRequest="180"
                   Aspect="AspectFill"
                   IsVisible="{Binding Recipe.ImagePath, Converter={StaticResource StringNotEmptyConverter}}" />

            <Border Padding="20" BackgroundColor="{DynamicResource CardBackgroundColor}"
                    Stroke="{DynamicResource AccentColor}" StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding Recipe.Emoji}" FontSize="48" HorizontalOptions="Center" />
                    <Label Text="{Binding Recipe.Name}" FontAttributes="Bold"
                           FontSize="{DynamicResource TitleFontSize}" TextColor="{DynamicResource PrimaryTextColor}" />
                    <Label Text="{Binding Recipe.Description}" TextColor="{DynamicResource SecondaryTextColor}" />
                    <Label Text="{Binding Recipe.Calories, StringFormat='Energy: {0} kcal'}" TextColor="{DynamicResource AccentColor}" />
                    <Label Text="{Binding Recipe.Category, StringFormat='Category: {0}'}" />
                </VerticalStackLayout>
            </Border>

            <Label Text="Ingredients" FontAttributes="Bold" FontSize="{DynamicResource SubtitleFontSize}" />
            <Label Text="{Binding Recipe.Ingredients}" LineBreakMode="WordWrap" TextColor="{DynamicResource PrimaryTextColor}" />

            <Label Text="Cooking steps" FontAttributes="Bold" FontSize="{DynamicResource SubtitleFontSize}" />
            <Label Text="{Binding Recipe.Steps}" LineBreakMode="WordWrap" TextColor="{DynamicResource PrimaryTextColor}" />

            <HorizontalStackLayout Spacing="8">
                <Button Text="Read aloud" Command="{Binding ReadStepsAloudCommand}" />
                <Button Text="Stop" Command="{Binding StopReadingAloudCommand}" IsVisible="{Binding IsSpeaking}" />
                <Button Text="{Binding Recipe.IsFavorite, Converter={StaticResource FavoriteGlyphConverter}}"
                        Command="{Binding ToggleFavoriteCommand}" />
            </HorizontalStackLayout>

            <HorizontalStackLayout Spacing="8">
                <Button Text="Edit" Command="{Binding EditRecipeCommand}" />
                <Button Text="Delete" Command="{Binding DeleteRecipeCommand}" BackgroundColor="#C62828" />
            </HorizontalStackLayout>

            <Label Text="{Binding StatusMessage}" TextColor="{DynamicResource SecondaryTextColor}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
